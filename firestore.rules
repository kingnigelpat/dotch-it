rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Business document rules
    match /businesses/{businessId} {
      // 1. Anyone (buyers, tourists, researchers, public) can read listings
      allow read: if true;

      // 2. Creation: Owner or Admin (normal users cannot self-approve active listing)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.ownerUid == request.auth.uid && request.resource.data.status != 'active')
      );

      // 3. Updates: Owner or Admin (normal users cannot change approval status directly)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.ownerUid == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'paymentApproved']))
      );

      // 4. Delete: Owner or Admin
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.ownerUid == request.auth.uid
      );
    }

    // Advertisements collection
    match /advertisements/{adId} {
      // Anyone can read active ads
      allow read: if true;
      // Only admin can create, update, or delete ads
      allow create, update, delete: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Normal users cannot grant themselves admin role or approve payments
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && request.resource.data.role != 'admin' && request.resource.data.paymentApproved != true)
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentApproved', 'role']))
      );
      allow delete: if isAdmin();
    }
  }
}
