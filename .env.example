# ============================================================
#  DOTCH — API KEYS
#  Copy this file to `.env` and fill in your real keys.
#  Never share the .env file with anyone.
# ============================================================

# ---------- FIREBASE (from console.firebase.google.com) ----------
# Project settings > General > Your apps > Web app > SDK setup and config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------- CLOUDINARY (from cloudinary.com console) ----------
# Dashboard > Cloud name  (example: "dx9abc123")
VITE_CLOUDINARY_CLOUD_NAME=
# Settings > Upload > Upload presets > Create unsigned preset (or copy existing)
# IMPORTANT: must be an UNSIGNED preset so the browser can upload directly.
VITE_CLOUDINARY_UPLOAD_PRESET=

# ---------- PAYSTACK (from dashboard.paystack.com/#/settings/developer) ----------
# Public Key (e.g. pk_test_... or pk_live_...) for monthly vendor subscription payments
VITE_PAYSTACK_PUBLIC_KEY=

# ---------- OPENROUTER (from openrouter.ai, free model) ----------
# You can use a free model like: meta-llama/llama-3.3-70b-instruct:free
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
